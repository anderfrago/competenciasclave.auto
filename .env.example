# Backend
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=
ADMIN_EMAILS=
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000
# En PythonAnywhere apunta a frontend/dist/autopercepcion-cc/browser
SPA_DIST_PATH=

# Correo SMTP autorizado por el centro (verificación de cuentas).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Acceso con Google. Crear las credenciales en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Producción HTTPS: true. Solo desarrollo local HTTP: false.
COOKIE_SECURE=true
# Correos exactos autorizados para alta (separados por comas).
REGISTRATION_EMAILS=
# Sin plazo aprobado, dejar vacío: el borrado queda deshabilitado.
RETENTION_DAYS=
# Completar y validar por el centro antes de usar con alumnado.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_LEGAL_BASIS=
PRIVACY_RETENTION=
PRIVACY_PROVIDERS=
